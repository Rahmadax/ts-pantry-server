          <camunda:inputParameter name="templateId">hello_world_template</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>start_flow</bpmn:incoming>
      <bpmn:outgoing>end_flow</bpmn:outgoing>
      <bpmn:script>execution.setVariable("hello_world", "Hello World!");</bpmn:script>
