    </bpmn:endEvent>
    <bpmn:sequenceFlow id="end_flow" sourceRef="hello_world" targetRef="hello_world_end" />
    <bpmn:scriptTask id="hello_world" name="Hello World!" camunda:asyncBefore="true" camunda:exclusive="false" scriptFormat="javascript">
      <bpmn:extensionElements>
