<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1vqm47w" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.8.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="dispute_item_not_arrived" name="Dispute: Item Not Arrived" isExecutable="true" camunda:versionTag="0.1.0">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property name="default_component" value="37a9782b-2f69-4c1e-b520-f5323ac05429:1" />
      </camunda:properties>
    </bpmn:extensionElements>
    <bpmn:startEvent id="start_proc" name="start" camunda:initiator="initiator">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;active_user&#39;, execution.getVariable(&#39;initiator&#39;))}" event="start" />
      </bpmn:extensionElements>
      <bpmn:outgoing>start_setup_flow</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="setup_subproc" name="Setup">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;active_user&#39;, execution.getVariable(&#39;initiator&#39;))}" event="start" />
        <camunda:executionListener expression="${execution.removeVariable(&#39;active_user&#39;)}&#34;" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>start_setup_flow</bpmn:incoming>
      <bpmn:outgoing>setup_end_flow</bpmn:outgoing>
      <bpmn:startEvent id="start_setup" name="setup&#10;start">
        <bpmn:outgoing>setup_start_get_receipt_flow</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="end_setup" name="setup&#10;end">
        <bpmn:incoming>set_seller_setup_end_flow</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="setup_start_get_receipt_flow" sourceRef="start_setup" targetRef="get_receipt_information_task" />
      <bpmn:sequenceFlow id="get_receipt_set_buyer_flow" sourceRef="get_receipt_information_task" targetRef="set_buyer_participant_task" />
      <bpmn:sequenceFlow id="set_buyer_set_seller_flow" sourceRef="set_buyer_participant_task" targetRef="set_seller_participant_task" />
      <bpmn:sequenceFlow id="set_seller_setup_end_flow" sourceRef="set_seller_participant_task" targetRef="end_setup" />
      <bpmn:serviceTask id="get_receipt_information_task" name="Get Receipt Information" camunda:type="external" camunda:topic="get_receipt_information">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="receipt_id">${context.jsonPath("$.receipt_id").stringValue()}</camunda:inputParameter>
            <camunda:inputParameter name="transaction_id">${context.jsonPath("$.transaction_id").stringValue()}</camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:field name="field_transaction_id">
            <camunda:expression>${context.jsonPath("$.transaction_id").stringValue()}</camunda:expression>
          </camunda:field>
          <camunda:field name="field_receipt_id">
            <camunda:expression>${context.jsonPath("$.receipt_id").stringValue()}</camunda:expression>
          </camunda:field>
        </bpmn:extensionElements>
        <bpmn:incoming>setup_start_get_receipt_flow</bpmn:incoming>
        <bpmn:outgoing>get_receipt_set_buyer_flow</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="set_buyer_participant_task" name="Set Buyer Participant" camunda:type="external" camunda:topic="set_participant_task">
        <bpmn:incoming>get_receipt_set_buyer_flow</bpmn:incoming>
        <bpmn:outgoing>set_buyer_set_seller_flow</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="set_seller_participant_task" name="Set Seller Participant" camunda:type="external" camunda:topic="set_participant_task">
        <bpmn:incoming>set_buyer_set_seller_flow</bpmn:incoming>
        <bpmn:outgoing>set_seller_setup_end_flow</bpmn:outgoing>
      </bpmn:serviceTask>
    </bpmn:subProcess>
    <bpmn:endEvent id="end_proc" name="end">
      <bpmn:incoming>setup_end_flow</bpmn:incoming>
      <bpmn:incoming>setup_timeout_end_flow</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="start_setup_flow" sourceRef="start_proc" targetRef="setup_subproc" />
    <bpmn:sequenceFlow id="setup_end_flow" sourceRef="setup_subproc" targetRef="end_proc" />
    <bpmn:sequenceFlow id="setup_timeout_end_flow" name="1 Hour Timeout" sourceRef="setup_timeout" targetRef="end_proc" />
    <bpmn:boundaryEvent id="setup_timeout" camunda:asyncBefore="true" camunda:exclusive="false" attachedToRef="setup_subproc">
      <bpmn:outgoing>setup_timeout_end_flow</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_11w3w55">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
  </bpmn:process>
