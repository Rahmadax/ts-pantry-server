  <bpmn:process id="dispute_item_not_arrived" name="Dispute: Item Not Arrived" isExecutable="true" camunda:versionTag="0.1.10">
    <bpmn:startEvent id="proc_start" name="start" camunda:initiator="active_user">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;initiator&#39;, execution.getVariable(&#39;active_user&#39;))}" event="start" />
      </bpmn:extensionElements>
      <bpmn:outgoing>start_get_reciept_information_flow</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="proc_end" name="end">
      <bpmn:incoming>close_dispute_end_flow</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="start_get_reciept_information_flow" sourceRef="proc_start" targetRef="get_receipt_info_task" />
    <bpmn:subProcess id="buyer_subproc" name="Buyer Flow">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;active_user&#39;, execution.getVariable(&#39;buyer_id&#39;))}" event="start" />
        <camunda:executionListener expression="${execution.removeVariable(&#39;active_user&#39;)}&#34;" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>set_seller_buyer_flow_flow</bpmn:incoming>
