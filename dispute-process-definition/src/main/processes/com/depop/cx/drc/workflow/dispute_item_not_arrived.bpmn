      <bpmn:sequenceFlow id="set_buyer_summary_buyer_flow_end_flow" sourceRef="set_buyer_summary_task" targetRef="buyer_flow_end" />
      <bpmn:serviceTask id="set_buyer_summary_task" name="Set Buyer Summary" camunda:expression="a4cd7f7c-17a5-11ec-9621-0242ac130002" camunda:resultVariable="summary_component">
        <bpmn:incoming>buyer_choice_2_set_buyer_summary_flow</bpmn:incoming>
        <bpmn:outgoing>set_buyer_summary_buyer_flow_end_flow</bpmn:outgoing>
