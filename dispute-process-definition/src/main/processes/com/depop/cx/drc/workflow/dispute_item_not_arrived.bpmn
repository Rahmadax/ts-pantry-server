      <bpmn:sequenceFlow id="buyer_flow_start_buyer_choice_flow" sourceRef="buyer_flow_start" targetRef="buyer_choice_task_1" />
      <bpmn:userTask id="buyer_choice_task_2" name="Buyer Choice 2" camunda:assignee="${buyer_id}">
        <bpmn:extensionElements>
          <camunda:properties>
