<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0e1x425" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.8.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:collaboration id="sample_process_collaboration">
    <bpmn:participant id="customer" name="Sample Process" processRef="sample_process" />
  </bpmn:collaboration>
  <bpmn:process id="sample_process" name="sample_process" isExecutable="true" camunda:versionTag="6">
    <bpmn:laneSet id="LaneSet_1g1w1d9">
      <bpmn:lane id="buyer_lane" name="Buyer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get_order_details_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buyer_confirm_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buyer_choice_task</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="seller_lane" name="Seller">
        <bpmn:flowNodeRef>seller_confirm_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>seller_choice_task</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" camunda:initiator="initiator">
      <bpmn:outgoing>start_select_order_flow</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="start_select_order_flow" sourceRef="start" targetRef="get_order_details_task" />
    <bpmn:sequenceFlow id="buyer_confirm_seller_choice_flow" sourceRef="buyer_confirm_task" targetRef="seller_choice_task" />
    <bpmn:sequenceFlow id="select_order_buyer_choice_flow" sourceRef="get_order_details_task" targetRef="buyer_choice_task" />
    <bpmn:task id="get_order_details_task" name="Get Order Details">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="transaction_id">${context.jsonPath("$.transaction_id").stringValue()}</camunda:inputParameter>
          <camunda:outputParameter name="buyer">${initiator}</camunda:outputParameter>
          <camunda:outputParameter name="order_total">£1.50</camunda:outputParameter>
          <camunda:outputParameter name="seller">
            <camunda:script scriptFormat="javascript">var seller = 'bob';
if(initiator === 'bob') {
  seller = 'alice'
}
seller</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>start_select_order_flow</bpmn:incoming>
      <bpmn:outgoing>select_order_buyer_choice_flow</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="buyer_choice_buyer_confirm_flow" sourceRef="buyer_choice_task" targetRef="buyer_confirm_task" />
    <bpmn:userTask id="buyer_confirm_task" name="Buyer Confirm&#10;" camunda:assignee="${assigned_buyer}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="assigned_buyer">${buyer}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:formData>
          <camunda:formField id="buyer_confirm" label="Confirm" type="boolean" defaultValue="false" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>buyer_choice_buyer_confirm_flow</bpmn:incoming>
      <bpmn:outgoing>buyer_confirm_seller_choice_flow</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="buyer_choice_task" name="Buyer Choice&#10;" camunda:assignee="${assigned_buyer}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="assigned_buyer">${buyer}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:formData>
          <camunda:formField id="buyer_selected_option" label="Choose your mood...." type="enum" defaultValue="ok">
            <camunda:value id="vhappy" name="Very Happy" />
            <camunda:value id="happy" name="Happy" />
            <camunda:value id="ok" name="OK" />
            <camunda:value id="sad" name="Sad" />
            <camunda:value id="angry" name="Angry" />
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>select_order_buyer_choice_flow</bpmn:incoming>
      <bpmn:outgoing>buyer_choice_buyer_confirm_flow</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="seller_confirm_task" name="Seller Confirm" camunda:assignee="${assigned_seller}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="assigned_seller">${seller}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:formData>
          <camunda:formField id="seller_confirm" label="Confirm" type="boolean" defaultValue="false" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>seller_choice_seller_confirm_flow</bpmn:incoming>
      <bpmn:outgoing>seller_confirm_end_flow</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end" name="End">
      <bpmn:incoming>seller_confirm_end_flow</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="seller_choice_task" name="Seller Choice&#10;" camunda:assignee="${assigned_seller}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="assigned_seller">${seller}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:formData>
          <camunda:formField id="seller_selected_option" label="Help the buyer by..." type="enum" defaultValue="bite_nose">
            <camunda:value id="bite_nose" name="Biting the buyer&#39;s nose" />
            <camunda:value id="burn_house" name="Burning the buyer&#39;s house" />
            <camunda:value id="buy_present" name="Buying the buyer a present" />
            <camunda:value id="go_to_space" name="Firing yourself into space" />
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>buyer_confirm_seller_choice_flow</bpmn:incoming>
      <bpmn:outgoing>seller_choice_seller_confirm_flow</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="seller_choice_seller_confirm_flow" sourceRef="seller_choice_task" targetRef="seller_confirm_task" />
    <bpmn:sequenceFlow id="seller_confirm_end_flow" sourceRef="seller_confirm_task" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="sample_process_collaboration">
      <bpmndi:BPMNShape id="Participant_1ce6znn_di" bpmnElement="customer" isHorizontal="true">
        <dc:Bounds x="129" y="40" width="1231" height="670" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_0syfwb0_di" bpmnElement="seller_lane" isHorizontal="true">
        <dc:Bounds x="159" y="375" width="1201" height="335" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1lb80j0_di" bpmnElement="buyer_lane" isHorizontal="true">
        <dc:Bounds x="159" y="40" width="1201" height="335" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1snenrl_di" bpmnElement="seller_confirm_end_flow">
        <di:waypoint x="1190" y="560" />
        <di:waypoint x="1252" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1g0xci2_di" bpmnElement="seller_choice_seller_confirm_flow">
        <di:waypoint x="1020" y="560" />
        <di:waypoint x="1090" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0k6xca3_di" bpmnElement="buyer_choice_buyer_confirm_flow">
        <di:waypoint x="610" y="210" />
        <di:waypoint x="680" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0p94t8g_di" bpmnElement="select_order_buyer_choice_flow">
        <di:waypoint x="440" y="210" />
        <di:waypoint x="510" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0xrm6tw_di" bpmnElement="buyer_confirm_seller_choice_flow">
        <di:waypoint x="780" y="210" />
        <di:waypoint x="850" y="210" />
        <di:waypoint x="850" y="560" />
        <di:waypoint x="920" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0intcgr_di" bpmnElement="start_select_order_flow">
        <di:waypoint x="258" y="210" />
        <di:waypoint x="340" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="start">
        <dc:Bounds x="222" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="229" y="235" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0ru9k6c_di" bpmnElement="get_order_details_task">
        <dc:Bounds x="340" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1w4vzev_di" bpmnElement="buyer_confirm_task">
        <dc:Bounds x="680" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0rpaieu_di" bpmnElement="buyer_choice_task">
        <dc:Bounds x="510" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1gmy5yg_di" bpmnElement="seller_confirm_task">
        <dc:Bounds x="1090" y="520" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_179zgsr_di" bpmnElement="end">
        <dc:Bounds x="1252" y="542" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1260" y="585" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0bbqcfe_di" bpmnElement="seller_choice_task">
        <dc:Bounds x="920" y="520" width="100" height="80" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
